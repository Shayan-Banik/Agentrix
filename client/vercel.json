{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://agentrix-eniw.onrender.com/:path*"
    },
    {
      "source": "/api/agent/agents",
      "destination": "https://agentrix-agent.onrender.com/agents"
    },
    {
      "source": "/api/chat/:path*",
      "destination": "https://agentrix-gateway-ps6e.onrender.com/api/chat/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://agentrix-gateway-ps6e.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}